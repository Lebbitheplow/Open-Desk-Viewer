<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenDeskViewer managed configuration.

  This is the list an MDM console offers an administrator, and it is the only
  provisioning channel a preinstalled or MDM-deployed client has: it is started
  by an Intent and never sees the boot arguments the desktop client uses.

  The keys are the client's own config keys, so what is typed here is what the
  client stores. A build with its deployment baked in needs only
  enrollment-token; the four server keys are the fallback for an unlocked build.
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <restriction
        android:key="enrollment-token"
        android:restrictionType="string"
        android:title="Enrollment token"
        android:description="@string/restriction_enrollment_token_description"
        android:defaultValue="" />

    <restriction
        android:key="serial-number"
        android:restrictionType="string"
        android:title="Serial number or asset tag"
        android:description="@string/restriction_serial_number_description"
        android:defaultValue="" />

    <restriction
        android:key="api-server"
        android:restrictionType="string"
        android:title="API server"
        android:description="@string/restriction_api_server_description"
        android:defaultValue="" />

    <restriction
        android:key="custom-rendezvous-server"
        android:restrictionType="string"
        android:title="ID server"
        android:description="@string/restriction_rendezvous_server_description"
        android:defaultValue="" />

    <restriction
        android:key="relay-server"
        android:restrictionType="string"
        android:title="Relay server"
        android:description="@string/restriction_relay_server_description"
        android:defaultValue="" />

    <restriction
        android:key="key"
        android:restrictionType="string"
        android:title="Server public key"
        android:description="@string/restriction_key_description"
        android:defaultValue="" />

</restrictions>
