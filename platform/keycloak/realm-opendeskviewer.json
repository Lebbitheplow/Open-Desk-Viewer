{
  "id": "opendeskviewer",
  "realm": "opendeskviewer",
  "displayName": "OpenDeskViewer",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>OpenDeskViewer</span></div>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxLoginFailureWaitSeconds": 900,
  "failureFactor": 10,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "requiredCredentials": ["password"],
  "providers": [],
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "internationalizationEnabled": true,
  "defaultLocale": "en",
  "supportedLocales": ["en"],
  "sslRealmRelativeUrl": "protocol/openid-connect",
  "smtpServer": {},
  "issuer": "http://${keycloak.host}:8080/realms/opendeskviewer",
  
  "clients": [
    {
      "clientId": "odv-api",
      "name": "OpenDeskViewer API",
      "description": "Backend API client for RustDesk Pro compatibility",
      "type": "confidential",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "odv-api",
            "id.token.claim": true,
            "access.token.claim": true
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "id.token.claim": true,
            "access.token.claim": true,
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": true
          }
        }
      ],
      "fullScopeAllowed": true,
      "directAccessGrantsEnabled": true,
      "secret": "${keycloak.api.client.secret}"
    },
    {
      "clientId": "odv-portal",
      "name": "OpenDeskViewer Portal",
      "description": "Frontend portal for web interface",
      "type": "public",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "odv-portal",
            "id.token.claim": true
          }
        },
        {
          "name": "role list",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "id.token.claim": true,
            "access.token.claim": true,
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": true
          }
        }
      ],
      "fullScopeAllowed": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "${portal.url}",
      "redirectUris": [
        "${portal.url}/*"
      ],
      "webOrigins": [
        "+"
      ]
    }
  ],
  
  "users": [],
  
  "roles": {
    "realm": [
      {
        "id": "administrator",
        "name": "Administrator",
        "description": "Full system access - can manage all users, devices, and settings"
      },
      {
        "id": "support-manager",
        "name": "Support Manager",
        "description": "Can manage technicians and customers, view all devices"
      },
      {
        "id": "technician",
        "name": "Technician",
        "description": "Can access devices assigned to their support groups and connect remotely"
      },
      {
        "id": "read-only",
        "name": "Read Only",
        "description": "Can view devices and reports but cannot make changes"
      }
    ]
  },
  
  "groups": [],
  
  "defaultRoles": ["read-only"],
  
  "realmRoles": ["Administrator", "Support Manager", "Technician", "Read Only"],
  
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; img-src 'self' data:; script-src 'self'; style-src 'self';",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xXSSProtection": "1; mode=block",
    "cacheControl": "no-store",
    "xFrameOptions": "SAMEORIGIN"
  },
  
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "offlineSessionMaxLifespan": 5184000,
  
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 600,
  "accessCodeLifespanUserAction": 300,
  
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "EXPORTED",
    "LOGOUT",
    "LOGOUT_ERROR"
  ],
  
  "eventsEnabled": false,
  "eventsListeners": ["jboss-logging"],
  "enabledEventListeners": ["jboss-logging"]
}
