# OpenDeskViewer Configuration
# Copy this file to .env and fill in your values.
#
# Every variable below is read by something: docker-compose.yml, the Go API's
# internal/config, or the portal's build args. Anything the code does not read
# has been removed rather than left as documentation of a setting that silently
# does nothing.

# ==============================================================================
# Core Services
# ==============================================================================

# PostgreSQL database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opendeskviewer
POSTGRES_USER=opendeskviewer
POSTGRES_PASSWORD=change_me_in_production
# libpq sslmode. The code defaults to require; compose overrides it to disable
# for the bundled Postgres, which sits on the private network with no
# certificate. Point POSTGRES_HOST at an external database and this must become
# require, or verify-full if you supply a root certificate.
POSTGRES_SSLMODE=disable

# The password of odv_app, the role the API serves requests as.
#
# POSTGRES_USER above owns the schema and is used for migrations only. odv_app
# owns nothing, which is the point: an owner is not restricted by its own grants
# and can disable its own triggers, so the append-only audit log would have been
# append-only only against accident. odv_app may SELECT and INSERT on
# audit_events and nothing else.
#
# The role is created by platform/postgres/init/20-application-role.sh on first
# initialisation and granted its privileges by migration 000008. Leaving this
# empty makes the API fall back to the owner and say so in a startup warning;
# that is the pre-000008 behaviour and it is weaker.
#
# The background worker still connects as the owner, because expiring audit rows
# past the retention period is a delete and odv_app may not do one. The worker
# listens on no port.
POSTGRES_APP_PASSWORD=change_me_in_production

# Keycloak's own database. It is a separate role and database on the same
# Postgres, created by platform/postgres/init/10-keycloak-database.sh the first
# time the data directory is initialised. Postgres only runs that script on an
# empty data directory, so changing these on an existing deployment means
# creating the role and database by hand.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_in_production

# Keycloak service address on the internal network. The API fetches the JWKS
# from here, which keeps key retrieval off the public interface.
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=opendeskviewer

# Realm clients. OIDC_CLIENT_API is the confidential client the API validates
# token audiences against; OIDC_CLIENT_PORTAL is the public client the browser
# uses with authorization code + PKCE.
OIDC_CLIENT_API=odv-api
OIDC_CLIENT_PORTAL=odv-portal

# Secret for the odv-api client.
#
# Nothing reads it, and that is deliberate rather than an oversight. The API
# verifies tokens against the JWKS and never presents a secret; the RustDesk
# client's browser sign-in runs the authorization code exchange as the public
# odv-portal client with PKCE, which is what removed the need for one. It is
# kept here because Keycloak generates a secret for a confidential client
# whether or not anybody uses it, and an operator who finds one in the admin
# console should have somewhere to record it.
#
# Keycloak's realm import does not substitute ${env.VAR} placeholders, so the
# realm file does not pin this value.
OIDC_CLIENT_SECRET=change_me_in_production

# Keycloak admin credentials for the administration console. The console is not
# exposed through Caddy; reach it with an SSH tunnel or `docker compose port`.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production

# ==============================================================================
# RustDesk Services (hbbs/hbbr - upstream OSS, unmodified)
# ==============================================================================

# The public hostname clients and browsers connect to. Must be a real public
# name, not localhost or an internal IP: Caddy provisions a certificate for it
# and Keycloak stamps it into every token's issuer claim.
PUBLIC_HOST=your-public-hostname-or-ip

# RustDesk rendezvous server (TCP/21116, UDP/21116)
RENDEZVOUS_PORT=21116

# RustDesk relay server (TCP/21117)
RELAY_PORT=21117

# RustDesk public key (generated by hbbs on first run)
# Copy from /data/id_ed25519.pub after first hbbs startup
RUSTDESK_PUBLIC_KEY=change_me_after_first_hbbs_startup

# ==============================================================================
# API Server Configuration
# ==============================================================================

# Server listen address
API_HOST=0.0.0.0
API_PORT=8000

# Signing secret for the API's own session tokens. Must be at least 64
# characters; the server refuses to start otherwise.
JWT_SECRET=change_me_in_production_64_chars_minimum_please

JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=86400

# The AES-256 key that encrypts every managed device's connection password at
# rest. Required; the API refuses to start without a valid one, because a
# deployment running without it would show a portal offering password rotation
# that does nothing.
#
#   openssl rand -base64 32
#
# Losing it means losing every device password: the devices keep the one they
# were last given and nobody can read it any more, so the fleet has to be
# re-enrolled. Back it up wherever the database credentials are backed up.
# Changing it has the same effect, so rotate it only with a plan to re-enroll.
DEVICE_PASSWORD_KEY=change_me_openssl_rand_base64_32

# The issuer the API requires in every token. This is the PUBLIC realm URL,
# because that is what Keycloak puts in the iss claim once KC_HOSTNAME is set.
# Pointing it at http://keycloak:8080 would reject every token a browser
# presents. Must end in /realms/${KEYCLOAK_REALM}; the API validates this at
# startup and refuses to run otherwise.
OIDC_ISSUER=https://your-public-hostname-or-ip/realms/opendeskviewer

OIDC_AUTH_URL=https://your-public-hostname-or-ip/realms/opendeskviewer/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://your-public-hostname-or-ip/realms/opendeskviewer/protocol/openid-connect/token
OIDC_REDIRECT_URI=https://your-public-hostname-or-ip/callback

# Browser origins allowed to call the API with credentials. Leave empty and the
# API sends no CORS headers at all, which is the safe default: the portal is
# served from the same origin as the API and does not need them. Only set this
# if you serve the portal from a different origin.
CORS_ORIGINS=

# Bootstrap admin user.
# This user gets the Administrator role auto-created on first API startup.
API_BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com

# ==============================================================================
# Fleet Management
# ==============================================================================

# Device naming template
# Placeholders: {customer}, {location}, {serial}, {random}, {count}
DEVICE_NAME_TEMPLATE={customer}-{location}-{serial}

# Device state timeouts (seconds)
DEVICE_STALE_AFTER_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=900

# Maximum peers in one address book. 0 means no limit, which is what the client
# assumes when the field is absent.
AB_MAX_PEER_ONE_AB=0

# Audit retention (days)
AUDIT_RETENTION_DAYS=90

# ==============================================================================
# Worker Configuration
# ==============================================================================

WORKER_INTERVAL_HEARTBEAT_CHECK_SECONDS=60
WORKER_INTERVAL_TOKEN_CLEANUP_HOURS=24
WORKER_INTERVAL_AUDIT_CLEANUP_DAYS=1

# ==============================================================================
# Reverse Proxy (Caddy)
# ==============================================================================

# Caddy terminates TLS and proxies to the services. These should match your
# public DNS configuration. Caddy provisions a Let's Encrypt certificate for
# PUBLIC_HOST automatically once ports 80 and 443 are reachable from the
# internet.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ACME account email. Let's Encrypt sends certificate expiry warnings here, so
# a public deployment should set it. Empty registers an anonymous account, which
# is what a localhost deployment with a self-signed certificate wants.
CADDY_ACME_EMAIL=

# ==============================================================================
# Deployment Options
# ==============================================================================

# Enable debug logging
DEBUG=false

# Apply database migrations on startup. Set to false only if you apply them out
# of band; the API refuses to serve traffic against a schema it does not know.
ODV_MIGRATE=true
