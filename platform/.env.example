# OpenDeskViewer Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Services
# ==============================================================================

# PostgreSQL database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opendeskviewer
POSTGRES_USER=opendeskviewer
POSTGRES_PASSWORD=change_me_in_production

# Keycloak authentication
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=opendeskviewer
KEYCLOAK_CLIENT_API=odv-api
KEYCLOAK_CLIENT Portal=odv-portal
KEYCLOAK_CLIENT_SECRET=change_me_in_production
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/opendeskviewer/protocol/openid-connect/certs

# Keycloak admin credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production

# ==============================================================================
# RustDesk Services (hbbs/hbbr - upstream OSS, unmodified)
# ==============================================================================

# External addresses that clients will connect to
# These MUST be public addresses (not localhost or internal network IPs)
PUBLIC_HOST=your-public-hostname-or-ip

# RustDesk rendezvous server (TCP/21116, UDP/21116)
# Default: 21116
RENDEZVOUS_PORT=21116

# RustDesk relay server (TCP/21117)
# Default: 21117
RELAY_PORT=21117

# RustDesk API server (HTTP, port 21114 = 21116 - 2)
# Clients auto-derive this from RENDEZVOUS_HOST
RENDENZVOUS_HOST=${PUBLIC_HOST}

# RustDesk public key (generated by hbbs on first run)
# Copy from /data/id_ed25519.pub after first hbbs startup
RUSTDESK_PUBLIC_KEY=change_me_after_first_hbbs_startup

# ==============================================================================
# API Server Configuration
# ==============================================================================

# Server listen address
API_HOST=0.0.0.0
API_PORT=8000

# JWT configuration
JWT_SECRET=change_me_in_production_64_chars_minimum_please
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=86400

# OIDC / Keycloak
OIDC_ISSUER=http://keycloak:8080/realms/opendeskviewer
OIDC_AUTH_URL=http://keycloak:8080/realms/opendeskviewer/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://keycloak:8080/realms/opendeskviewer/protocol/openid-connect/token
OIDC_CLIENT_ID=odv-api
OIDC_CLIENT_SECRET=change_me_in_production
OIDC_REDIRECT_URI=http://api:8000/api/v1/oidc/callback

# Bootstrap admin user
# This user gets Administrator role auto-created on first API startup
API_BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com

# ==============================================================================
# Fleet Management
# ==============================================================================

# Device naming template
# Placeholders: {customer}, {location}, {serial}, {random}, {count}
DEVICE_NAME_TEMPLATE={customer}-{location}-{serial}

# Device state timeouts (seconds)
DEVICE_STALE_AFTER_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=900

# Audit retention (days)
AUDIT_RETENTION_DAYS=90

# ==============================================================================
# Security & Authorization
# ==============================================================================

# Casbin model file

# Role names (must match Keycloak realm roles)
ROLE_ADMINISTRATOR=Administrator
ROLE_SUPPORT_MANAGER=Support Manager
ROLE_TECHNICIAN=Technician
ROLE_READ_ONLY=Read Only

# ==============================================================================
# Worker Configuration
# ==============================================================================

WORKER_INTERVAL_HEARTBEAT_CHECK_SECONDS=60
WORKER_INTERVAL_TOKEN_CLEANUP_HOURS=24
WORKER_INTERVAL_AUDIT_CLEANUP_DAYS=1

# ==============================================================================
# Reverse Proxy (Caddy)
# ==============================================================================

# Caddy will terminate TLS and proxy to the services
# These should match your public DNS configuration
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Certificate configuration
# For production, use your own certificates or Let's Encrypt
# Caddy can auto-provision Let's Encrypt certs if DNS is configured
CADDY_ACME_EMAIL=your-email@example.com

# ==============================================================================
# Deployment Options
# ==============================================================================

# Enable debug logging
DEBUG=false

# Database migration policy
# auto: apply migrations on startup
# manual: require manual sql/migrate
DB_MIGRATION_POLICY=auto
